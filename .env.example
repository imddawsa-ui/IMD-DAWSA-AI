APP_NAME=IMD DAWSA AI
HOST=127.0.0.1
PORT=8000
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=gpt-4o-mini
CLOUD_API_KEY=
DATABASE_PATH=./data/imd_dawsa.sqlite3
# Generate a unique random value locally before enabling accounts:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=86400
# Resend email verification (production requires an HTTPS public API URL)
RESEND_API_KEY=
EMAIL_FROM=IMD DAWSA AI <verify@your-verified-domain.com>
API_PUBLIC_URL=https://api.example.com
EMAIL_VERIFICATION_TTL_SECONDS=900
API_ACCESS_TOKEN=
MAX_MESSAGE_CHARS=12000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
